<?xml version="1.0" encoding="utf-8"?>
<!-- Picking any character as a key: a field to type or paste into, and lists to tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/custom_layout_characters_typed"
        style="@style/CustomLayout.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:hint="@string/custom_layout_text_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/custom_layout_characters_lists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
