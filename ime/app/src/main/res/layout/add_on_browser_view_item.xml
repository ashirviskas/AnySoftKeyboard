<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <include layout="@layout/item_keyboard_include_layout"
        android:id="@+id/item_keyboard_view_background"/>

    <!-- The name, and next to it the control to change this add-on itself (a pencil) or to open
         what it stands for (a text). A long name gives way, so the control is never pushed out. -->
    <LinearLayout
        android:id="@+id/title_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/item_keyboard_view_background"
        android:layout_centerHorizontal="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            style="@style/Ask.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:singleLine="true" />

        <TextView
            android:id="@+id/edit_image"
            style="@style/CustomLayout.Link"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:contentDescription="@string/custom_layout_edit"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Ask.Text.SubTitle"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/title_row"
        android:id="@+id/subtitle"/>

    <ImageView
        android:id="@+id/enabled_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/item_selected_circle_background"
        android:src="@drawable/ic_accept"/>
</RelativeLayout>
