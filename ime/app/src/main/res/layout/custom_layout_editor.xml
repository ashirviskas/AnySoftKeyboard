<?xml version="1.0" encoding="utf-8"?>
<!--
    The layout editor. The keyboard being edited is shown whole and is the thing the user works
    on; the tabs under (or over) it are named after what is being changed: a key, a row, or the
    whole keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!--
        The keyboard, and over it what it is shown as (the kind of field; whole or split).
        First: on top. The fragment moves it to the end when the user wants it at the bottom.
    -->
    <LinearLayout
        android:id="@+id/custom_layout_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/custom_layout_preview_setups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/custom_layout_preview_hint"
            style="@style/CustomLayout.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:text="@string/custom_layout_preview_look_only"
            android:visibility="gone" />

        <com.anysoftkeyboard.keyboards.views.CustomLayoutEditorView
            android:id="@+id/custom_layout_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/custom_layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/custom_layout_accent"
        app:tabIndicatorHeight="2dp"
        app:tabRippleColor="@color/custom_layout_accent_tint"
        app:tabSelectedTextColor="@color/custom_layout_accent"
        app:tabTextAppearance="@style/CustomLayout.Text"
        app:tabTextColor="@color/custom_layout_muted" />

    <View style="@style/CustomLayout.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Key: the picked key, its width, what is beside it, and the keys to put there -->
            <LinearLayout
                android:id="@+id/custom_layout_key_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/custom_layout_selection"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/custom_layout_selection_hint"
                            style="@style/CustomLayout.Text.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                        <TextView
                            android:id="@+id/custom_layout_go_to_row"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/custom_layout_edges_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="76dp"
                            android:text="@string/custom_layout_key_width" />

                        <SeekBar
                            android:id="@+id/custom_layout_key_width"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:progressTint="@color/custom_layout_line"
                            android:thumbTint="@color/custom_layout_accent" />

                        <EditText
                            android:id="@+id/custom_layout_key_width_value"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/custom_layout_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:minWidth="56dp"
                            android:paddingHorizontal="8dp"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/custom_layout_accent" />
                    </LinearLayout>

                    <!-- which edges of the key a new width moves: both, so it grows on both sides -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CustomLayout.Text.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/custom_layout_width_moves" />

                        <CheckBox
                            android:id="@+id/custom_layout_width_moves_left"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:buttonTint="@color/custom_layout_accent"
                            android:checked="true"
                            android:text="@string/custom_layout_width_moves_left" />

                        <CheckBox
                            android:id="@+id/custom_layout_width_moves_right"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:buttonTint="@color/custom_layout_accent"
                            android:checked="true"
                            android:text="@string/custom_layout_width_moves_right" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="76dp"
                            android:text="@string/custom_layout_left_edge" />

                        <SeekBar
                            android:id="@+id/custom_layout_left_edge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:progressTint="@color/custom_layout_line"
                            android:thumbTint="@color/custom_layout_accent" />

                        <EditText
                            android:id="@+id/custom_layout_left_edge_value"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/custom_layout_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:minWidth="56dp"
                            android:paddingHorizontal="8dp"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/custom_layout_accent" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="76dp"
                            android:text="@string/custom_layout_right_edge" />

                        <SeekBar
                            android:id="@+id/custom_layout_right_edge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:progressTint="@color/custom_layout_line"
                            android:thumbTint="@color/custom_layout_accent" />

                        <EditText
                            android:id="@+id/custom_layout_right_edge_value"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/custom_layout_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:minWidth="56dp"
                            android:paddingHorizontal="8dp"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/custom_layout_accent" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/custom_layout_insert_left"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_insert_left" />

                        <TextView
                            android:id="@+id/custom_layout_insert_right"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_insert_right" />

                        <TextView
                            android:id="@+id/custom_layout_even_keys"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/custom_layout_split_key"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_split_key" />

                        <TextView
                            android:id="@+id/custom_layout_lock_key"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/custom_layout_duplicate_key"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_duplicate_key" />

                        <TextView
                            android:id="@+id/custom_layout_remove_key"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- what the picked key has of its own: filled by the editor, one line per value -->
                <LinearLayout
                    android:id="@+id/custom_layout_key_values"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View style="@style/CustomLayout.Divider" />

                    <TextView
                        style="@style/CustomLayout.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/custom_layout_key_values" />
                </LinearLayout>

                <View style="@style/CustomLayout.Divider" />

                <!-- how touches on the keyboard are taken -->
                <CheckBox
                    android:id="@+id/custom_layout_pick_several"
                    style="@style/CustomLayout.Text"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/custom_layout_accent"
                    android:text="@string/custom_layout_pick_several" />

                <CheckBox
                    android:id="@+id/custom_layout_resize_evens_side"
                    style="@style/CustomLayout.Text"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/custom_layout_accent"
                    android:text="@string/custom_layout_resize_evens_side" />

                <CheckBox
                    android:id="@+id/custom_layout_resize_keeps_proportions"
                    style="@style/CustomLayout.Text"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/custom_layout_accent"
                    android:text="@string/custom_layout_resize_keeps_proportions" />

                <View style="@style/CustomLayout.Divider" />

                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_usual_keys" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/custom_layout_usual_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />

                <View style="@style/CustomLayout.Divider" />

                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_keyboard_keys" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/custom_layout_keyboard_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />
            </LinearLayout>

            <!-- Row: its height, the gaps at its sides, and adding and removing rows -->
            <LinearLayout
                android:id="@+id/custom_layout_row_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/custom_layout_row_title"
                            style="@style/CustomLayout.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/custom_layout_row_keys"
                            style="@style/CustomLayout.Text.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                        <TextView
                            android:id="@+id/custom_layout_row_up"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_row_up" />
                        <TextView
                            android:id="@+id/custom_layout_row_down"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_row_down" />
                </LinearLayout>

                <View style="@style/CustomLayout.Divider" />

                <LinearLayout
                    android:id="@+id/custom_layout_row_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- the gap at each side of the row: filled by the editor -->
                <LinearLayout
                    android:id="@+id/custom_layout_side_gaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <CheckBox
                    android:id="@+id/custom_layout_same_side_gaps"
                    style="@style/CustomLayout.Text"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:buttonTint="@color/custom_layout_accent"
                    android:checked="true"
                    android:text="@string/custom_layout_same_side_gaps" />

                <View style="@style/CustomLayout.Divider" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/custom_layout_even_row"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/custom_layout_add_row_above"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_add_row_above" />

                        <TextView
                            android:id="@+id/custom_layout_add_row"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_add_row" />

                        <TextView
                            android:id="@+id/custom_layout_duplicate_row"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_duplicate_row" />

                        <TextView
                            android:id="@+id/custom_layout_move_row_up"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_move_row_up" />

                        <TextView
                            android:id="@+id/custom_layout_move_row_down"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_move_row_down" />

                        <TextView
                            android:id="@+id/custom_layout_remove_row"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </HorizontalScrollView>

                <View style="@style/CustomLayout.Divider" />

                <!-- the kinds of field the row is part of the keyboard for -->
                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_row_fields" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/custom_layout_row_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />

                <TextView
                    style="@style/CustomLayout.Text.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="12dp"
                    android:text="@string/custom_layout_row_fields_hint" />
            </LinearLayout>

            <!-- Keyboard: its name, its height as a whole, and the layout as something to share -->
            <LinearLayout
                android:id="@+id/custom_layout_keyboard_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/custom_layout_name"
                    style="@style/CustomLayout.Text"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_layout_chip"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/custom_layout_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/custom_layout_total_height"
                        style="@style/CustomLayout.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/custom_layout_total_height_hint"
                        style="@style/CustomLayout.Text.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/CustomLayout.Divider" />

                <LinearLayout
                    android:id="@+id/custom_layout_size_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View style="@style/CustomLayout.Divider" />

                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_spacing" />

                <!-- the gaps between keys and rows: filled by the editor -->
                <LinearLayout
                    android:id="@+id/custom_layout_spacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/custom_layout_theme_spacing"
                    style="@style/CustomLayout.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/custom_layout_theme_spacing" />

                <View style="@style/CustomLayout.Divider" />

                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_dictionary" />

                <TextView
                    android:id="@+id/custom_layout_dictionary"
                    style="@style/CustomLayout.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" />

                <View style="@style/CustomLayout.Divider" />

                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_snap" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/custom_layout_snap"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp" />

                <View style="@style/CustomLayout.Divider" />

                <TextView
                    style="@style/CustomLayout.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_layout_checks" />

                <TextView
                    android:id="@+id/custom_layout_checks"
                    style="@style/CustomLayout.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp" />

                <View style="@style/CustomLayout.Divider" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/custom_layout_copy"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_copy" />

                        <TextView
                            android:id="@+id/custom_layout_paste"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_paste" />

                        <TextView
                            android:id="@+id/custom_layout_export"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_export" />

                        <TextView
                            android:id="@+id/custom_layout_import"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_import" />

                        <TextView
                            android:id="@+id/custom_layout_duplicate"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_duplicate" />

                        <TextView
                            android:id="@+id/custom_layout_reset"
                            style="@style/CustomLayout.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_layout_reset" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
