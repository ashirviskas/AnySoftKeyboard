<?xml version="1.0" encoding="utf-8"?>
<!-- An empty keyboard outline: the place of a keyboard the user has not made yet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/custom_layout_create_card_height"
    android:layout_margin="8dp"
    android:background="@drawable/custom_layout_create_outline"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="@color/custom_layout_muted"
        android:textSize="36sp" />

    <TextView
        style="@style/CustomLayout.Text.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_layout_create" />
</LinearLayout>
