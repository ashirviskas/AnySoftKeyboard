<?xml version="1.0" encoding="utf-8"?>
<!-- A key chip for a key that is not on the layout. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/custom_layout_accent_tint">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/custom_layout_accent_tint" />
            <stroke android:width="1dp" android:color="@color/custom_layout_accent" />
        </shape>
    </item>
</ripple>
